              "host": [
                "{{base_url}}"
              ],
              "path": [
                "analytics",
                "activity",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"activity_type\": \"career_viewed\",\n      \"career_id\": 2336\n    }\n  ]\n}",
