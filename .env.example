# =============================================================================
# Pathzi Backend — environment variables (TEMPLATE, FAKE VALUES ONLY)
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# Never put real values in this file — it is committed to git.
# Real values live in `.env` (git-ignored) and in the DigitalOcean App Spec.
#
# REQUIRED = the app will not start without it.
# =============================================================================

# --- Django core --------------------------------------------------------------
SECRET_KEY=your-long-random-secret-key                # REQUIRED
DEBUG=False
# Signs login tokens. Defaults to SECRET_KEY. Changing it logs every user out.
JWT_SIGNING_KEY=your-other-long-random-secret-key

# --- Database (Neon PostgreSQL + pgvector) ------------------------------------
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require   # REQUIRED

# --- Redis (cache, rate limits, Celery broker) --------------------------------
REDIS_URL=rediss://default:password@your-redis-host:25061   # REQUIRED

# --- Email (Resend SMTP) ------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=Pathzi <no-reply@example.com>             # REQUIRED — must be on a domain verified in Resend
# Optional overrides (defaults shown):
# EMAIL_HOST=smtp.resend.com
# EMAIL_HOST_USER=resend
# EMAIL_PORT=587

# --- Google Sign-In -----------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=your-web-client-id       # REQUIRED
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id   # REQUIRED
GOOGLE_IOS_CLIENT_ID=your-ios-client-id       # REQUIRED
GOOGLE_CLIENT_ID=your-google-client-id           # REQUIRED
GOOGLE_CLIENT_SECRET=your-google-client-secret                        # REQUIRED
GOOGLE_REDIRECT_URI=https://your-app.example.com/accounts/auth/google/callback/   # REQUIRED

# --- Sign in with Apple -------------------------------------------------------
APPLE_CLIENT_ID=com.example.app.signin                                     # REQUIRED
APPLE_CLIENT_ID_FLUTTER=com.example.app                                    # REQUIRED
APPLE_REDIRECT_URI=https://your-app.example.com/accounts/auth/apple/callback/     # REQUIRED

# --- In-app subscriptions (RevenueCat) ----------------------------------------
REVENUECAT_SECRET_KEY=your-revenuecat-secret-api-key
REVENUECAT_WEBHOOK_SECRET=your-webhook-authorization-value        # the Authorization header value set in RevenueCat
REVENUECAT_SIGNING_SECRET=your-webhook-signing-secret        # the HMAC signing secret set in RevenueCat
REVENUECAT_PROJECT_ID=your-revenuecat-project-id
REVENUECAT_ENTITLEMENT_ID=pathzi_pro
# Turn on only when the app with the paywall screen is live.
PAYWALL_ENFORCED=False

# --- Web subscriptions (Stripe) — not used by the app since Aug 2026 ----------
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_API_VERSION=2025-11-17.clover
STRIPE_PRICE_ID_MONTHLY=your-monthly-price-id
STRIPE_PRICE_ID_QUARTERLY=your-quarterly-price-id
STRIPE_PRICE_ID_YEARLY=your-yearly-price-id
BILLING_RETURN_URL=https://your-app.example.com/careers/

# --- AI career plan (Google Gemini) -------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Location search (Geoapify) -----------------------------------------------
GEOAPIFY_API_KEY=your-geoapify-api-key                  # REQUIRED
GEOAPIFY_DEFAULT_COUNTRY=gb                               # REQUIRED (can be empty)

# --- HTTPS hardening (all default to "on" when DEBUG=False) -------------------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
